# Frontend build-time configuration (public values only).
VITE_APP_NAME=GOZIE LIVE
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set Worker secrets with wrangler secret put. NEVER commit real values.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LIVEKIT_URL=                 # LiveKit WebSocket URL, e.g. wss://...
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# APP_ORIGIN=                  # Deployed web app origin, e.g. https://...
# ENGINE_SHARED_SECRET=
# R2_ACCESS_KEY_ID=            # S3-compatible R2 API credentials for Egress recording
# R2_SECRET_ACCESS_KEY=
# R2_S3_ENDPOINT=              # https://<cloudflare-account-id>.r2.cloudflarestorage.com
